# =============================================================================
# CMO Agent V2 (Path B REST Microservice) - Environment Template
# Copy this file to .env on your VM or configure in GitHub Actions Secrets/Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Server & Host Configuration
# -----------------------------------------------------------------------------
ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8000

# -----------------------------------------------------------------------------
# 2. Authentication & TANTRA Governance
# -----------------------------------------------------------------------------
# Enforces Bearer token authentication on /api/v1/* routes
API_AUTH_ENABLED=true

# Set to 'false' for staging / local VM (accepts test bearer tokens)
# Set to 'true' in strict production (enforces TANTRA Sarathi RS256 cryptographic signature)
AUTH_STRICT_RS256=false

# Authoritative TANTRA Bearer Token (provisioned for CMO_AGENT)
# TANTRA_BEARER_TOKEN=Bearer eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# 3. MASTERDB Knowledge & Persistence Platform
# -----------------------------------------------------------------------------
# Local VM / Docker Compose: http://127.0.0.1:8000 or http://masterdb:8000
# Cloud Staging / Production: https://bhiv-masterdb-ingestion-certification.onrender.com
MASTERDB_URL=http://127.0.0.1:8000
MASTERDB_APP_ID=CMO_AGENT
MASTERDB_CAPABILITY_ID=cap-cmo-marketing-intelligence

# -----------------------------------------------------------------------------
# 4. Storage, Logging & Audit
# -----------------------------------------------------------------------------
RAG_LOG_LEVEL=INFO
RAG_LOG_FILE=logs/cmo_service.log
RAG_RANDOM_SEED=42

# -----------------------------------------------------------------------------
# 5. RAG Generation Engine & Cloud Providers (Optional)
# -----------------------------------------------------------------------------
# Generation Mode: "mock" (default, deterministic offline, sub-15ms, zero cloud fees),
# or cloud LLM providers: "gemini", "groq", "grok"
RAG_GENERATION_MODE=mock

# Cloud API Keys (Leave blank if running in deterministic "mock" mode)
GROK_API_KEY=
GROK_MODEL=grok-beta

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
