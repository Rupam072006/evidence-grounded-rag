# Evidence-Grounded RAG System Configuration Example
# Copy this file to .env and insert your actual configuration if using external providers.
# DO NOT commit .env with secrets to source control.

# Google Gemini API Key (Optional: system runs fully offline in deterministic mock mode if not provided)
GEMINI_API_KEY=your_gemini_api_key_here

# Generation Mode: "mock" (default, deterministic offline) or "gemini" (live Google GenAI)
RAG_GENERATION_MODE=mock

# Gemini Model Name (when mode is "gemini")
GEMINI_MODEL=gemini-1.5-flash

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
RAG_LOG_LEVEL=INFO

# Random Seed for Reproducibility
RAG_RANDOM_SEED=42
