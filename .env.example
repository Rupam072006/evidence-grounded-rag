# Evidence-Grounded RAG System Configuration Example
# Copy this file to .env and insert your actual configuration if using external providers.
# DO NOT commit .env with secrets to source control.

# Generation Mode: "mock" (default, deterministic offline), "grok" (xAI Grok), "groq" (Groq Cloud), or "gemini"
RAG_GENERATION_MODE=mock

# xAI Grok API Key (https://console.x.ai/)
GROK_API_KEY=your_xai_grok_api_key_here
GROK_MODEL=grok-beta

# Groq Cloud API Key (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key (Optional)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
RAG_LOG_LEVEL=INFO

# Random Seed for Reproducibility
RAG_RANDOM_SEED=42
